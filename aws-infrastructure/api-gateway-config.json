{
  "openapi": "3.0.1",
  "info": {
    "title": "MindCare API",
    "description": "REST API for MindCare mental health platform",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.mindcare.com/v1",
      "description": "Production server"
    },
    {
      "url": "https://dev-api.mindcare.com/v1",
      "description": "Development server"
    }
  ],
  "paths": {
    "/auth/validate": {
      "post": {
        "summary": "Validate JWT token",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token validation result"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/arn:aws:lambda:${AWS_REGION}:${ACCOUNT_ID}:function:mindcare-auth-handler/invocations"
        }
      }
    },
    "/auth/user": {
      "get": {
        "summary": "Get user information",
        "tags": ["Authentication"],
        "security": [
          {
            "CognitoAuthorizer": []
          }
        ],
        "responses": {
          "200": {
            "description": "User information"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/arn:aws:lambda:${AWS_REGION}:${ACCOUNT_ID}:function:mindcare-auth-handler/invocations"
        }
      },
      "put": {
        "summary": "Update user attributes",
        "tags": ["Authentication"],
        "security": [
          {
            "CognitoAuthorizer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "phone": {
                    "type": "string"
                  },
                  "role": {
                    "type": "string",
                    "enum": ["user", "counsellor", "admin"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/arn:aws:lambda:${AWS_REGION}:${ACCOUNT_ID}:function:mindcare-auth-handler/invocations"
        }
      }
    },
    "/chat/send": {
      "post": {
        "summary": "Send message to AI chatbot",
        "tags": ["Chat"],
        "security": [
          {
            "CognitoAuthorizer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userId": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "conversationHistory": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI response"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/arn:aws:lambda:${AWS_REGION}:${ACCOUNT_ID}:function:mindcare-chat-handler/invocations"
        }
      }
    },
    "/chat/history": {
      "get": {
        "summary": "Get chat history",
        "tags": ["Chat"],
        "security": [
          {
            "CognitoAuthorizer": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chat history"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/arn:aws:lambda:${AWS_REGION}:${ACCOUNT_ID}:function:mindcare-chat-handler/invocations"
        }
      }
    },
    "/voice/transcribe": {
      "post": {
        "summary": "Start voice transcription",
        "tags": ["Voice"],
        "security": [
          {
            "CognitoAuthorizer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "audioFileUri": {
                    "type": "string"
                  },
                  "userId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transcription job started"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/arn:aws:lambda:${AWS_REGION}:${ACCOUNT_ID}:function:mindcare-voice-handler/invocations"
        }
      }
    },
    "/voice/synthesize": {
      "post": {
        "summary": "Synthesize speech from text",
        "tags": ["Voice"],
        "security": [
          {
            "CognitoAuthorizer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "voiceId": {
                    "type": "string",
                    "default": "Joanna"
                  },
                  "userId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Audio synthesized successfully"
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "aws_proxy",
          "httpMethod": "POST",
          "uri": "arn:aws:apigateway:${AWS_REGION}:lambda:path/2015-03-31/functions/arn:aws:lambda:${AWS_REGION}:${ACCOUNT_ID}:function:mindcare-voice-handler/invocations"
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CognitoAuthorizer": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "x-amazon-apigateway-authtype": "cognito_user_pools",
        "x-amazon-apigateway-authorizer": {
          "type": "cognito_user_pools",
          "providerARNs": [
            "arn:aws:cognito-idp:${AWS_REGION}:${ACCOUNT_ID}:userpool/${USER_POOL_ID}"
          ]
        }
      }
    }
  },
  "x-amazon-apigateway-cors": {
    "allowOrigins": [
      "http://localhost:5173",
      "https://mindcare.com",
      "https://*.amplifyapp.com"
    ],
    "allowMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ],
    "allowHeaders": [
      "Content-Type",
      "Authorization",
      "X-Amz-Date",
      "X-Api-Key",
      "X-Amz-Security-Token"
    ],
    "maxAge": 3600
  }
}
