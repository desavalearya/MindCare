# ============================================================
# NODE / VITE
# ============================================================
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.local
build/
out/
*.tsbuildinfo

# ============================================================
# ENVIRONMENT FILES — NEVER COMMIT
# ============================================================
.env
.env.*
!.env.example         # safe to commit — contains only placeholder values
server/.env
server/.env.*
!server/.env.example
des/.env

# ============================================================
# AWS CREDENTIALS & SECRETS — NEVER COMMIT
# ============================================================
aws-credentials.json
credentials.json
*-credentials.json
*.pem
*.key
*.cert

# ============================================================
# INFRASTRUCTURE & TERRAFORM — contains account IDs / ARNs
# ============================================================
infrastructure/
aws-infrastructure/

# ============================================================
# LOG & RUNTIME OUTPUT FILES
# ============================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
server_logs.txt
server_errors.txt
frontend_logs.txt
frontend_errors.txt

# ============================================================
# DATABASE DUMPS & EXPORTS
# ============================================================
*.sql.backup
*.db
*.sqlite
*.sqlite3

# ============================================================
# CSV FILES — may contain user / emotion data
# ============================================================
*.csv
emotion_log.csv
des/emotion_log.csv

# ============================================================
# PYTHON ARTIFACTS
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
des/__pycache__/
des/*.pyc
des/.pytest_cache/
venv/
env/
ENV/

